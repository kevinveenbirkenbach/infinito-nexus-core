msgstr "**Beschrijving:** Centrale recursieve / doorstuur DNSSEC resolver op een statisch IP voor de consument stacks te richten als hun DNS"

# translated-by: libretranslate
msgid "**Description:** Central search and analytics engine with per-consumer index namespaces isolating tenants in a shared Docker deployment"
msgstr "**Beschrijving:** Centrale zoek- en analyse-engine met per-consumer index namespaces isoleren huurders in een gedeelde Docker implementatie"

# translated-by: libretranslate
msgid "**Description:** Central vector database engine for storing and searching per-consumer embeddings shared across the stack"
msgstr "**Beschrijving:** Centrale vector database engine voor het opslaan en zoeken van per-consumer inbeddingen gedeeld over de stack"

# translated-by: libretranslate
msgid "**Description:** Centralized MariaDB or PostgreSQL database service shared across applications via Docker Compose"
msgstr "**Beschrijving:** Gecentraliseerd MariaDB of PostgreSQL databasedienst gedeeld over toepassingen via Docker Compose"

# translated-by: libretranslate
