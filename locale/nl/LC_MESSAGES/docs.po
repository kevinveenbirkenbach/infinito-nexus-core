msgstr "INFINITO_IMAGE_REPOSITORY: kleine repository naam opgelost uit scripts/meta/resolve/repository/name.sh (Alleen GHA)."

# translated-by: libretranslate
msgid "INFINITO_IS_WSL2: true when /proc/version identifies the host as WSL2."
msgstr "INFINITO_IS_WSL2: waar wanneer /proc/version de host identificeert als WSL2."

# translated-by: libretranslate
