msgstr "INFINITO_PARENT_IMAGE: verwijzing naar de verdelingsbasisafbeelding samengesteld uit INFINITO_PARENT_IMAGE_OWNER, INFINITO_DISTRO en INFINITO_PARENT_IMAGE_TAG."

# translated-by: libretranslate
msgid "INFINITO_PLAYWRIGHT_REPORTS_BASE_DIR: per-app Playwright reports root, derived from the var-lib SPOT (INFINITO_DIR_VAR_LIB)."
msgstr "INFINITO_PLAYWRIGHT_REPORTS_BASE_DIR: per-app Playwright rapporteert root, afgeleid van de var-lib SPOT (INFINITO_DIR_VAR_LIB)."

