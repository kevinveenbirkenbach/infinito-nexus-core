msgstr "INFINITO_CA_CERT_HOST: host pad van de zelf ondertekende root CA cert."

# translated-by: libretranslate
msgid "INFINITO_CONTAINER: compose service container name derived from INFINITO_DISTRO. Always overrides whatever the static-env default was."
msgstr "INFINITO_CONTAINER: samenstelling service container naam afgeleid van INFINITO_DISTRO. Altijd overschrijft wat de statische-env standaard was."

# translated-by: libretranslate
msgid "INFINITO_DIR_BACKUPS: local backup root, derived from the var-lib SPOT (INFINITO_DIR_VAR_LIB); mirrors group_vars/all/05_paths.yml DIR_BACKUPS."
msgstr "INFINITO_DIR_BACKUPS: lokale back-up wortel, afgeleid van de var-lib SPOT (INFINITO_DIR_VAR_LIB); spiegels group_vars/all/05_paths.yml DIR_BACKUPS."

# translated-by: libretranslate
msgid "INFINITO_DIR_SECRETS: host secrets dir, derived from the var-lib SPOT (INFINITO_DIR_VAR_LIB); mirrors group_vars/all/05_paths.yml DIR_SECRETS."
msgstr "INFINITO_DIR_SECRETS: gastheergeheimen dir, afgeleid van de var-lib SPOT (INFINITO_DIR_VAR_LIB); spiegels group_vars/all/05_paths.yml DIR_SECRETS."

# translated-by: libretranslate
msgid "INFINITO_DIR_VAR_LIB: Infinito state/secrets base dir, read from the group_vars paths SPOT (group_vars/all/05_paths.yml DIR_VAR_LIB)."
msgstr "INFINITO_DIR_VAR_LIB: Infinito state/secrets base dir, gelezen uit de group_vars paden SPOT (group_vars/all/05_paths.yml DIR_VAR_LIB)."

# translated-by: libretranslate
msgid "INFINITO_DISTROS: every distro id declared in meta/distros.yml."
msgstr "INFINITO_DISTROS: elke distro id aangegeven in meta/distros.yml."

# translated-by: libretranslate
msgid "INFINITO_DNS53_SAMPLER_LOG: :53 sampler log, read from the group_vars paths SPOT (group_vars/all/05_paths.yml FILE_DNS53_SAMPLER_LOG)."
msgstr "INFINITO_DNS53_SAMPLER_LOG:53 sampler log, gelezen uit de group_vars paden SPOT (group_vars/all/05_paths.yml FILE_DNS53_SAMPLER_LOG)."

# translated-by: libretranslate
msgid "INFINITO_DOCKER_PLATFORM: target the architecture this deploy was assigned."
msgstr "INFINITO_DOCKER_PLATFORM: richt zich op de architectuur die deze inzet werd toegewezen."

# translated-by: libretranslate
msgid "INFINITO_DOCKER_VOLUME: GHA-side override pointing at the runner's large-disk mount."
msgstr "INFINITO_DOCKER_VOLUME: GHA-side override gericht op de grote schijfmount van de loper."

# translated-by: libretranslate
msgid "INFINITO_DOMAIN: ``<stack>.<INFINITO_DNS_DOMAIN>``, where the stack is ``main`` for the primary checkout and the normalised branch for a linked git worktree. Always overrides the caller env, which inside the stack container is the previous ``.env``; GitHub/act runs keep the static default and custom.env pins win."
msgstr "INFINITO_DOMAIN: ``<stack>.<INFINITO_DNS_DOMAIN>``, waar de stapel is ``main`` voor de primaire kassa en de genormaliseerde tak voor een gekoppelde git worktree. Altijd overschrijft de beller env, die in de stack container is de vorige ``.env``; GitHub/act draait houdt de statische standaard en custom.env Pinnen winnen."

# translated-by: libretranslate
msgid "INFINITO_FORK_ACCOUNT: GitHub account holding the operator's fork, defaulting to the local OS username."
msgstr "INFINITO_FORK_ACCOUNT: GitHub account met de vork van de exploitant, standaard voor de lokale OS gebruikersnaam."

# translated-by: libretranslate
msgid "INFINITO_FORK_REPOSITORY_URL: GitHub URL of the operator's fork, composed from INFINITO_FORK_ACCOUNT and INFINITO_FORK_REPOSITORY_NAME."
msgstr "INFINITO_FORK_REPOSITORY_URL: GitHub URL van de vork van de exploitant, samengesteld uit INFINITO_FORK_ACCOUNT en INFINITO_FORK_REPOSITORY_NAME."

# translated-by: libretranslate
msgid "INFINITO_GIT_AUTHOR_NAME / INFINITO_GIT_AUTHOR_EMAIL: the identity this checkout commits under. The test container mounts the checkout but not the contributor's git configuration, so the suite cannot ask git who is about to commit; the ``.env`` carries the answer across."
msgstr "INFINITO_GIT_AUTHOR_NAME ' INFINITO_GIT_AUTHOR_EMAIL: de identiteit die deze checkout commits onder. De test container mount de kassa maar niet de git configuratie van de contributor, dus de suite kan git niet vragen wie gaat committen; de ``.env`` draagt het antwoord over."

# translated-by: libretranslate
msgid "INFINITO_GPU_COUNT: GPUs the compose services reserve, 'all' when the docker daemon registers an NVIDIA runtime, else 0."
msgstr "INFINITO_GPU_COUNT: GPU's de samenstelling diensten reserve, 'all' wanneer de docker daemon een NVIDIA runtime registreert, anders 0."

# translated-by: libretranslate
msgid "INFINITO_I18N_BATCH_SIZE / INFINITO_I18N_LANES: client settings `make i18n-tune` measured on this host, falling back to the shipped defaults."
msgstr "INFINITO_I18N_BATCH_SIZE ' INFINITO_I18N_LANES: clientinstellingen `make i18n-tune` gemeten op deze host, terugvallend op de verzonden standaardinstellingen."

# translated-by: libretranslate
