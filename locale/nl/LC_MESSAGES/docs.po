# translated-by: libretranslate
msgid "**RBAC** — only users in the ``web-app-pihole-administrator`` group can access the dashboard"
msgstr "**RBAC** Alleen gebruikers in de ``web-app-pihole-administrator`` groep kan toegang krijgen tot het dashboard"

# translated-by: libretranslate
