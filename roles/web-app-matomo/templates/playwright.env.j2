PERSONA_ADMINISTRATOR_BLOCKED={{ 'false' if (lookup('config', application_id, 'services.sso.enabled') | bool) else 'true' }}

# nocheck: persona-block-rationale — Matomo admits only members of its RBAC roles: the deploy provisions an account for each of them and RebelOIDC signup stays off, so biber, who holds no Matomo role, has no Matomo account to land in; auth.spec.js asserts that denial (see README "Persona contract opt-outs").
PERSONA_BIBER_BLOCKED=true

