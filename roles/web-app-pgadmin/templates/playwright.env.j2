MATOMO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.matomo.enabled') | string | lower }}

# nocheck: persona-block-rationale — without SSO pgAdmin's only login id is the internal e-mail PGADMIN_DEFAULT_EMAIL, not the Keycloak username (see README "Persona contract opt-outs"); with SSO the shared helper clicks button[name='oauth2_button'].
PERSONA_ADMINISTRATOR_BLOCKED={{ 'false' if (lookup('config', application_id, 'services.sso.enabled') | bool) else 'true' }}

# nocheck: persona-block-rationale — vars/main.yml PGADMIN_OAUTH2_CONFIG admits only the administrator and user RBAC groups through OAUTH2_ADDITIONAL_CLAIMS and biber carries no roles, so pgAdmin refuses biber after the Keycloak login; files/playwright/test-rbac-roles.js asserts that refusal and the user-group admission (see README "Persona contract opt-outs").
PERSONA_BIBER_BLOCKED=true

