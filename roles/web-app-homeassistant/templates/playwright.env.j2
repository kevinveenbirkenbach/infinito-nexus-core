ADMIN_PASSWORD={{ HOMEASSISTANT_ADMIN_PASSWORD | dotenv_quote }}

ADMIN_USERNAME={{ HOMEASSISTANT_ADMIN_USERNAME | dotenv_quote }}

BIBER_PASSWORD={{ lookup('users', 'biber').password | dotenv_quote }}

BIBER_USERNAME={{ lookup('users', 'biber').username | dotenv_quote }}

CANONICAL_DOMAIN={{ lookup('domain', application_id) | dotenv_quote }}

DESIGN_FAVICON_URL={{ (lookup('design', application_id).urls.favicon_ico if lookup('design', application_id).logo is string else '') | dotenv_quote }}

DESIGN_LOGO_URL={{ (lookup('design', application_id).urls.logo.svg if lookup('design', application_id).logo is string else '') | dotenv_quote }}

DESIGN_SERVICE_ENABLED={{ lookup('config', application_id, 'services.design.enabled') | string | lower }}

DESIGN_THEME={{ HOMEASSISTANT_DESIGN_THEME | dotenv_quote }}

DESIGN_THEME_COLOR={{ HOMEASSISTANT_DESIGN_PRIMARY | dotenv_quote }}

DESIGN_TITLE={{ (lookup('design', application_id).title if lookup('design', application_id).title is string else '') | dotenv_quote }}

HOMEASSISTANT_BASE_URL={{ lookup('tls', application_id, 'url.base') | dotenv_quote }}

KEYCLOAK_ADMIN_CLI_CLIENT_ID={{ OIDC.ADMIN.CLI_CLIENT_ID | dotenv_quote }}

KEYCLOAK_ADMIN_REALM={{ OIDC.ADMIN.REALM | dotenv_quote }}

KEYCLOAK_BASE_URL={{ (OIDC.URL if 'web-app-keycloak' in group_names else '') | dotenv_quote }}

KEYCLOAK_REALM_NAME={{ OIDC.CLIENT.REALM | dotenv_quote }}

LDAP_PROVIDER_NAME={{ HOMEASSISTANT_LDAP_PROVIDER_NAME | dotenv_quote }}

LDAP_SERVICE_ENABLED={{ lookup('config', application_id, 'services.ldap.enabled') | string | lower }}

# nocheck: playwright-service-gate
MCP_SERVICE_ENABLED={{ lookup('config', application_id, 'mcp.enabled') | string | lower }}

# nocheck: persona-block-rationale: Home Assistant runs its own auth provider and meta/services.yml pins sso.enabled false, so the administrator persona has no OIDC path into the hub; its owner account is created once during headless onboarding and the shared helper drives no native hub form.
PERSONA_ADMINISTRATOR_BLOCKED=true

# nocheck: persona-block-rationale: meta/services.yml pins sso.enabled false and the directory sign-in admits only members of the hub's administrator or user role group, which biber is not, so no auth path admits biber; files/playwright/test-ldap-login.js covers the refusal and the user-group path.
PERSONA_BIBER_BLOCKED=true

RBAC_USER_GROUP_PATH={{ ('/' ~ lookup('rbac_group_path', application_id=application_id, role='user')) | dotenv_quote }}

SUPER_ADMIN_PASSWORD={{ (OIDC.ADMIN.PASSWORD | dotenv_quote) if 'web-app-keycloak' in group_names else '""' }}

SUPER_ADMIN_USERNAME={{ (OIDC.ADMIN.USERNAME | dotenv_quote) if 'web-app-keycloak' in group_names else '""' }}
