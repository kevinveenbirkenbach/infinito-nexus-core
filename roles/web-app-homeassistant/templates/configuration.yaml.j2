default_config:

{% if HOMEASSISTANT_DESIGN_ENABLED | bool %}
frontend:
  themes:
    {{ HOMEASSISTANT_DESIGN_THEME | to_json }}:
      primary-color: {{ HOMEASSISTANT_DESIGN_PRIMARY | to_json }}
      modes:
{% for mode in ['light', 'dark'] %}
        {{ mode }}:
{% for name, value in HOMEASSISTANT_DESIGN_VARIABLES | dictsort %}
          {{ name }}: {{ value | to_json }}
{% endfor %}
{% endfor %}

automation corporate_design:
  - id: corporate_design_theme
    alias: {{ (HOMEASSISTANT_DESIGN_THEME ~ ' theme') | to_json }}
    triggers:
      - trigger: homeassistant
        event: start
    actions:
      - action: frontend.set_theme
        data:
          name: {{ HOMEASSISTANT_DESIGN_THEME | to_json }}
          name_dark: {{ HOMEASSISTANT_DESIGN_THEME | to_json }}

{% endif %}
http:
  use_x_forwarded_for: true
  trusted_proxies:
{% for cidr in NETWORK_TRUSTED_PROXY_CIDRS %}
    - {{ cidr }}
{% endfor %}
{% if HOMEASSISTANT_LDAP_ENABLED | bool %}

homeassistant:
  auth_providers:
    - type: homeassistant
    - type: command_line
      name: {{ HOMEASSISTANT_LDAP_PROVIDER_NAME | to_json }}
      command: {{ HOMEASSISTANT_PYTHON | to_json }}
      args: {{ HOMEASSISTANT_LDAP_LOGIN_ARGUMENTS | to_json }}
      meta: true
{% endif %}
