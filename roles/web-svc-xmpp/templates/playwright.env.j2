ADMIN_PASSWORD={{ lookup('users', 'platform_administrator').password | dotenv_quote }}

ADMIN_USERNAME={{ lookup('users', 'platform_administrator').username | dotenv_quote }}

APP_BASE_URL={{ lookup('tls', application_id, 'url.base') }}

BIBER_DIRECTORY_FULL_NAME={{ lookup('users', 'biber') | ldap_full_name('biber') | dotenv_quote }}

BIBER_PASSWORD={{ lookup('users', 'biber').password | dotenv_quote }}

BIBER_USERNAME={{ lookup('users', 'biber').username | dotenv_quote }}

CANONICAL_DOMAIN={{ lookup('domain', application_id) | dotenv_quote }}

LDAP_SERVICE_ENABLED={{ lookup('config', application_id, 'services.ldap.enabled') | string | lower }}

LOGOUT_SERVICE_ENABLED={{ lookup('config', application_id, 'services.logout.enabled') | string | lower }}

NODE_TLS_REJECT_UNAUTHORIZED=0

# nocheck: persona-block-rationale — ejabberd's only HTTP surface is ejabberd_web_admin on /admin and mod_http_api on /api (templates/configuration.yml.j2); both authenticate a bare JID against LDAP via HTTP Basic, so there is no Keycloak redirect and no logout control to click. Client authentication itself runs over 5222/5269 (README "Watch Points").
PERSONA_ADMINISTRATOR_BLOCKED=true

# nocheck: persona-block-rationale — see PERSONA_ADMINISTRATOR_BLOCKED above; acl.admin lists only the platform administrator and the members of the administrator role, so the web admin refuses biber outright.
PERSONA_BIBER_BLOCKED=true

XMPP_BASE_URL={{ lookup('tls', application_id, 'url.base') | dotenv_quote }}

XMPP_HOST={{ XMPP_DOMAIN | dotenv_quote }}

