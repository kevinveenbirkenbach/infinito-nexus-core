cookie_secret           =   "{{ lookup('config', sso_proxy_application_id, 'secrets.credentials.sso_proxy_cookie_secret') }}"
{% set _domain_list = lookup('domains', sso_proxy_application_id) | domain_strings %}
{% set _network_domains = _domain_list | in_network(sso_proxy_network) %}
{% set _network_primary = _network_domains | first %}
cookie_secure           =   "{{ lookup('tls', _network_primary, 'enabled') | string | lower }}"
{% set _cookie_domains = lookup('sso_cookie_domains', sso_proxy_application_id) %}
{% if _cookie_domains %}
cookie_domains          =   {{ _cookie_domains | to_json }}
{% endif %}
whitelist_domains       =   {{ lookup('sso_whitelist_domains', sso_proxy_application_id) | to_json }}
redirect_url            =   "{{ lookup('tls', _network_primary, 'protocols.web') }}://{{ _network_primary }}/oauth2/callback"

{% if lookup('sso', sso_proxy_application_id, 'oauth2_allowed_groups') %}
email_domains           =   ["*"]
{% else %}
email_domains           =   "{{ DOMAIN_PRIMARY }}"
{% endif %}

session_store_type       = "redis"
redis_connection_url     = "{{ lookup('engine', 'redis', sso_proxy_application_id, 'url') }}"
