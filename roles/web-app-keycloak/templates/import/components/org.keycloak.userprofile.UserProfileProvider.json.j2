{% set _profile = namespace(attrs=[], groups=[]) %}
{% for attribute in KEYCLOAK_PROFILE_ATTRIBUTES %}
{% set _profile.attrs = _profile.attrs + [{
  "name": attribute.name,
  "displayName": attribute.display,
  "validations": {"length": {"max": attribute.max}},
  "permissions": {"view": ["admin","user"], "edit": KEYCLOAK_PROFILE_GROUPS[attribute.group].edit},
  "group": attribute.group,
  "multivalued": false
}] %}
{% endfor %}
{% for group_name, group in KEYCLOAK_PROFILE_GROUPS.items() %}
{% set _profile.groups = _profile.groups + [{
  "name": group_name,
  "displayHeader": group.header,
  "displayDescription": group.description
}] %}
{% endfor %}
{% set _base_attrs = [
  {
    "name": "username",
    "displayName": "${username}",
    "validations": {
      "length": { "min": 3, "max": IAM_ACCOUNT_MAX_LENGTH },
      "pattern": {
        "pattern": "^(?!(?:" ~ KEYCLOAK_RESERVED_USERNAMES_REGEX | replace('\\', '\\\\') ~ ")$)[a-z0-9]+$",
        "error-message": "Username is reserved or contains invalid characters. Only lowercase letters (a–z) and digits (0–9) are allowed."
      }
    },
    "annotations": {},
    "permissions": {"view": ["admin","user"], "edit": ["admin","user"]},
    "multivalued": false
  },
  {
    "name": "email",
    "displayName": "${email}",
    "validations": {"email": {}, "length": {"max": 255}},
    "required": {"roles": ["user"]},
    "permissions": {"view": ["admin","user"], "edit": ["admin","user"]},
    "multivalued": false
  },
  {
    "name": "firstName",
    "displayName": "${firstName}",
    "validations": {"length": {"max": 255}, "person-name-prohibited-characters": {}},
    "required": {"roles": ["user"]},
    "permissions": {"view": ["admin","user"], "edit": ["admin","user"]},
    "multivalued": false
  },
  {
    "name": "lastName",
    "displayName": "${lastName}",
    "validations": {"length": {"max": 255}, "person-name-prohibited-characters": {}},
    "required": {"roles": ["user"]},
    "permissions": {"view": ["admin","user"], "edit": ["admin","user"]},
    "multivalued": false
  },
  {
    "name": LDAP.USER.ATTRIBUTES.SSH_PUBLIC_KEY,
    "displayName": "SSH Public Key",
    "validations": {},
    "annotations": {},
    "permissions": {"view": ["admin","user"], "edit": ["admin","user"]},
    "group": "user-metadata",
    "multivalued": true
  },
  {
    "name": "uidNumber",
    "displayName": "POSIX uid",
    "validations": {"integer": {}},
    "annotations": {},
    "permissions": {"view": ["admin","user"], "edit": ["admin"]},
    "group": "user-metadata",
    "multivalued": false
  },
  {
    "name": LDAP.USER.ATTRIBUTES.NEXTCLOUD_QUOTA,
    "displayName": "Nextcloud quota",
    "validations": {"integer": {}},
    "annotations": {},
    "permissions": {"view": ["admin","user"], "edit": ["admin"]},
    "group": "user-metadata",
    "multivalued": false
  }
] %}
{% set user_profile = {
  "attributes": _base_attrs + _profile.attrs,
  "groups": [
    {
      "name": "user-metadata",
      "displayHeader": "User metadata",
      "displayDescription": "Attributes, which refer to user metadata"
    }
  ] + _profile.groups
} %}
"org.keycloak.userprofile.UserProfileProvider": [
  {
    "providerId": "declarative-user-profile",
    "name": "declarative-user-profile",
    "subComponents": {},
    "config": {
      "kc.user.profile.config": [{{ (user_profile | to_json) | to_json }}]
    }
  }
]
