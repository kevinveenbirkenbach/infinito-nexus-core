{% include 'roles/sys-svc-container/templates/env.j2' %}

ORCHESTRATOR_PORT={{ AGENT_ORCHESTRATOR_PORT }}
ORCHESTRATOR_KEY={{ AGENT_ORCHESTRATOR_KEY | dotenv_quote }}
ORCHESTRATOR_ALIAS={{ entity_name }}
ORCHESTRATOR_STATE_DIR={{ AGENT_ORCHESTRATOR_STATE_DIR }}
WEBHOOK_SECRET={{ AGENT_ORCHESTRATOR_WEBHOOK_SECRET | dotenv_quote }}
PUBLICLY_REACHABLE={{ AGENT_ORCHESTRATOR_PUBLICLY_REACHABLE | bool | string | lower }}
POLL_INTERVAL={{ AGENT_ORCHESTRATOR_POLL_INTERVAL }}
DATABASE_URL={{ lookup('database', application_id, 'url_full') | dotenv_quote }}
CHECKPOINT_ENCRYPTION_KEY={{ AGENT_ORCHESTRATOR_CHECKPOINT_KEY | dotenv_quote }}
CHECKPOINT_RETENTION_DAYS={{ AGENT_ORCHESTRATOR_RETENTION_DAYS }}
LITELLM_URL={{ LITELLM_BASE_LOCAL_URL }}
LITELLM_KEY={{ AGENT_ORCHESTRATOR_LITELLM_KEY | dotenv_quote }}
CHANNELS={{ AGENT_ORCHESTRATOR_CHANNELS | to_json | dotenv_quote }}
CRON_ENTRIES={{ AGENT_ORCHESTRATOR_CRON_ENTRIES | to_json | dotenv_quote }}
REQUEST_TIMEOUT={{ AGENT_ORCHESTRATOR_REQUEST_TIMEOUT }}
