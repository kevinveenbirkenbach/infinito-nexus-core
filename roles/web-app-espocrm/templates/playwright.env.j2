{% if not ESPOCRM_LDAP_ENABLED | bool %}
ADMIN_NATIVE_PASSWORD={{ ESPOCRM_ADMIN_PASSWORD | dotenv_quote }}
{% endif %}

ADMIN_PASSWORD={{ ESPOCRM_ADMIN_PASSWORD | dotenv_quote }}

ADMIN_USERNAME={{ ESPOCRM_ADMIN_USERNAME | dotenv_quote }}

APP_BASE_URL={{ lookup('tls', application_id, 'url.base') | dotenv_quote }}

BIBER_PASSWORD={{ lookup('users', 'biber').password | dotenv_quote }}

BIBER_USERNAME={{ lookup('users', 'biber').username | dotenv_quote }}

CANONICAL_DOMAIN={{ lookup('domain', application_id) | dotenv_quote }}

DESIGN_LOGO_URL={{ (lookup('design', application_id).urls.logo.svg if lookup('design', application_id).logo is string else '') | dotenv_quote }}

DESIGN_SERVICE_ENABLED={{ lookup('config', application_id, 'services.design.enabled') | string | lower }}

DESIGN_THEME={{ ESPOCRM_DESIGN_THEME | dotenv_quote }}

DESIGN_TITLE={{ (lookup('design', application_id).title if lookup('design', application_id).title is string else '') | dotenv_quote }}

# nocheck: playwright-service-gate — templates/env.j2 hands SMTP to the app via ESPOCRM_CONFIG_SMTP_*; no persona surface sends mail, real delivery is asserted in roles/web-app-mailu/files/playwright/playwright.spec.js
EMAIL_SERVICE_ENABLED={{ lookup('config', application_id, 'services.email.enabled') | string | lower }}

EMAIL_SMTP_HOST={{ lookup('email', application_id).host | dotenv_quote }}

EMAIL_SMTP_PORT={{ lookup('email', application_id).port }}

ESPOCRM_TEAM_MANAGER={{ ESPOCRM_RBAC_TIERS.manager.team | dotenv_quote }}

ESPOCRM_TEAM_USER={{ ESPOCRM_RBAC_TIERS.user.team | dotenv_quote }}

KEYCLOAK_BASE_URL={{ lookup('tls', 'web-app-keycloak', 'url.base') | dotenv_quote }}

KEYCLOAK_REALM_NAME={{ OIDC.CLIENT.REALM | dotenv_quote }}

LDAP_SERVICE_ENABLED={{ lookup('config', application_id, 'services.ldap.enabled') | string | lower }}

LOGOUT_SERVICE_ENABLED={{ lookup('config', application_id, 'services.logout.enabled') | string | lower }}

# nocheck: playwright-service-gate — the EspoCRM installer aborts without ESPOCRM_DATABASE_*, so every rendered page already proves MariaDB
MARIADB_SERVICE_ENABLED={{ lookup('config', application_id, 'services.mariadb.enabled') | string | lower }}

MATOMO_BASE_URL={{ lookup('tls', 'web-app-matomo', 'url.base') | dotenv_quote }}

MATOMO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.matomo.enabled') | string | lower }}

# nocheck: persona-block-rationale — biber holds no EspoCRM role group, and both sign-in paths admit only role-group members: the role-group OIDC user provider (files/php/rbac/group_user_provider.php) refuses biber with sso, ESPOCRM_CONFIG_LDAP_USER_LOGIN_FILTER refuses it with LDAP only; files/playwright/test-rbac.js asserts the refusal and drives biber through the role groups instead (see README "Persona contract opt-outs").
PERSONA_BIBER_BLOCKED=true

RBAC_GROUP_ADMINISTRATOR={{ ('/' ~ lookup('rbac_group_path', application_id=application_id, role='administrator')) | dotenv_quote }}

RBAC_GROUP_MANAGER={{ ('/' ~ lookup('rbac_group_path', application_id=application_id, role='manager')) | dotenv_quote }}

RBAC_GROUP_USER={{ ('/' ~ lookup('rbac_group_path', application_id=application_id, role='user')) | dotenv_quote }}

# nocheck: playwright-service-gate — reCAPTCHA v3 guards the native login form with live Google keys that a headless persona cannot satisfy
RECAPTCHA_SERVICE_ENABLED={{ lookup('config', application_id, 'services.recaptcha.enabled') | string | lower }}

SEAWEEDFS_APP_ACCESS_KEY={{ lookup('objstore', application_id, 'access_key') | dotenv_quote }}

SEAWEEDFS_APP_BUCKET={{ lookup('objstore', application_id, 'bucket') | dotenv_quote }}

SEAWEEDFS_APP_SECRET_KEY={{ lookup('objstore', application_id, 'secret_key') | dotenv_quote }}

SEAWEEDFS_REGION={{ lookup('config', 'web-svc-seaweedfs', 'services.seaweedfs.region') }}

SEAWEEDFS_S3_URL={{ lookup('canonical_url', 'web-svc-seaweedfs', 'api', consumer=application_id) | dotenv_quote }}

SEAWEEDFS_SERVICE_ENABLED={{ lookup('config', application_id, 'services.seaweedfs.enabled') | string | lower }}

SSO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.sso.enabled') | string | lower }}

SUPER_ADMIN_PASSWORD={{ (OIDC.ADMIN.PASSWORD | dotenv_quote) if (lookup('service', 'sso').required) else '""' }}

SUPER_ADMIN_USERNAME={{ (OIDC.ADMIN.USERNAME | dotenv_quote) if (lookup('service', 'sso').required) else '""' }}

{{ lookup('addon_env_flags', application_id) }}
