{% include 'roles/sys-svc-container/templates/env.j2' %}
{% if JITSI_KEYCLOAK_ADAPTER_ENABLED | bool %}

KEYCLOAK_ORIGIN={{ OIDC.URL }}
KEYCLOAK_REALM={{ OIDC.CLIENT.REALM }}
KEYCLOAK_CLIENT_ID={{ OIDC.CLIENT.ID }}
KEYCLOAK_CLIENT_SECRET={{ OIDC.CLIENT.SECRET | dotenv_quote }}
KEYCLOAK_MODE=query
JWT_ALG=HS256
JWT_HASH=SHA-256
JWT_APP_ID={{ JITSI_JWT_APP_ID }}
JWT_APP_SECRET={{ JITSI_JWT_APP_SECRET | dotenv_quote }}
JWT_EXP_SECOND=3600
HOSTNAME=0.0.0.0
PORT={{ JITSI_KEYCLOAK_ADAPTER_PORT }}
DENO_TLS_CA_STORE=system
{% endif %}
