{% include 'roles/sys-svc-compose/templates/base.yml.j2' %}

  {% set service_name = 'workspace' %}
  {{ service_name }}:
    {% include 'roles/sys-svc-container/templates/base.yml.j2' %}
    {{ lookup('container_image', application_id, 'workspace') }}
    build:
      context: {{ WORKSPACE_BUILD_DIR }}
      dockerfile: Dockerfile
      args:
        WORKSPACE_BASE_IMAGE: {{ WORKSPACE_BASE_IMAGE }}
        WORKSPACE_BASE_VERSION: "{{ WORKSPACE_BASE_VERSION }}"
    {{ lookup('compose_only', 'container_name', WORKSPACE_CONTAINER) }}
    {% if lookup('config', application_id, 'services.kata.enabled') | bool %}
    {{ lookup('compose_only', 'runtime', SANDBOX_RUNTIME) }}
    {% endif %}
    user: "0:0"
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    command:
      - "--host"
      - "0.0.0.0"
      - "--port"
      - "{{ WORKSPACE_PORT_INTERNAL }}"
      - "--connection-token"
      - "{{ WORKSPACE_CONNECTION_TOKEN }}"
      - "--default-folder"
      - "{{ WORKSPACE_DATA_DIR }}"
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:{{ WORKSPACE_PORT_INTERNAL }}/').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
      interval: 2m
      timeout: 5s
      retries: 5
      start_period: 10m
      start_interval: 5s
    {{ lookup('container_ports', ['workspace', 'http', DOCKER_BIND_HOST]) | indent(4) }}
    {{ lookup('container_volumes', service_name) | indent(4) }}
    {{ lookup('container_networks') | indent(4) }}
    {{ lookup('container_depends_on', application_id) | indent(4) }}

{{ lookup('compose_networks') }}

{{ lookup('compose_volumes') }}
