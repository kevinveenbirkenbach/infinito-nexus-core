APP_BASE_URL={{ lookup('tls', application_id, 'url.base') }}

CANONICAL_DOMAIN={{ lookup('domain', application_id) | dotenv_quote }}

LOGOUT_SERVICE_ENABLED={{ lookup('config', application_id, 'services.logout.enabled') | string | lower }}

NODE_TLS_REJECT_UNAUTHORIZED=0

# nocheck: persona-block-rationale  Code-OSS is a WebSocket IDE SPA with no server-rendered logout control the shared inAppLogout helper can reach; the oauth2-proxy SSO round trip is the auth proof
PERSONA_ADMINISTRATOR_BLOCKED=true

# nocheck: persona-block-rationale  the oauth2 proxy admits only the web-app-workspace administrator and agent-user RBAC groups and biber carries neither, so biber is refused before the IDE is reached
PERSONA_BIBER_BLOCKED=true

SSO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.sso.enabled') | string | lower }}

WORKSPACE_BASE_URL={{ lookup('tls', application_id, 'url.base') | dotenv_quote }}
