# nocheck: persona-block-rationale — with SSO off, templates/env.j2 renders `PROXY_HEADER_SSO=false` and the trusted-header bridge is dead, leaving only Baserow's own sign-in form, which asks for an e-mail address. The one account that exists is the Django superuser from tasks/01_manager_ops.yml, stored by files/python/bootstrap_admin.py under its e-mail address, so the Keycloak username the helper types never matches that form's identifier.
PERSONA_ADMINISTRATOR_BLOCKED={{ 'false' if (lookup('config', application_id, 'services.sso.enabled') | bool) else 'true' }}
# nocheck: persona-block-rationale — meta/services.yml `sso.oauth2.allowed_groups` admits only the web-app-baserow administrator and user RBAC groups and biber holds neither, so the oauth2-proxy denies biber (files/playwright/test-rbac.js asserts the denial and the admission with the user group); with SSO off nothing provisions a Baserow account for biber either — tasks/01_manager_ops.yml seeds the superuser and nobody else.
PERSONA_BIBER_BLOCKED=true

