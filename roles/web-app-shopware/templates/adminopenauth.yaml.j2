services:
  heptacom.admin_open_auth.oidc.http_client:
    class: 'GuzzleHttp\Client'
    arguments:
      - protocols: {{ ['http', 'https'] if (SHOPWARE_OIDC_INTERNAL_BASE | regex_search('^http://')) else ['https'] }}
        verify: true
        timeout: 15
        headers:
          Accept: application/json
  App\InfinitoRbac\AdminOpenAuthRoleGate:
    class: 'App\InfinitoRbac\AdminOpenAuthRoleGate'
    tags:
      - name: kernel.event_listener
        event: 'Heptacom\AdminOpenAuth\Http\Route\Support\UserRedirectReceivedEvent'
        method: __invoke
        priority: -100
