{% include 'roles/sys-svc-container/templates/env.j2' %}

PROVISIONER_PORT={{ AGENT_PROVISIONER_PORT }}
PROVISIONER_KEY={{ AGENT_PROVISIONER_KEY | dotenv_quote }}
PROVISIONER_ALIAS={{ entity_name }}
PROVISIONER_STATE_DIR={{ AGENT_PROVISIONER_STATE_DIR }}
LEASE_TTL={{ AGENT_PROVISIONER_LEASE_TTL }}
DATABASE_URL={{ lookup('database', application_id, 'url_full') | dotenv_quote }}
KEYCLOAK_URL={{ lookup('tls', 'web-app-keycloak', 'url.base') }}
KEYCLOAK_REALM={{ OIDC.CLIENT.REALM | dotenv_quote }}
KEYCLOAK_ADMIN_USERNAME={{ OIDC.ADMIN.USERNAME | dotenv_quote }}
KEYCLOAK_ADMIN_PASSWORD={{ OIDC.ADMIN.PASSWORD | dotenv_quote }}
LDAP_URI={{ LDAP.SERVER.URI | dotenv_quote }}
LDAP_USERS_BASE_DN={{ LDAP.DN.OU.USERS | dotenv_quote }}
LDAP_BIND_DN={{ LDAP.DN.ADMINISTRATOR.DATA | dotenv_quote }}
LDAP_BIND_PASSWORD={{ LDAP.BIND_CREDENTIAL | dotenv_quote }}
REQUEST_TIMEOUT={{ AGENT_PROVISIONER_REQUEST_TIMEOUT }}
