{% include 'roles/sys-svc-container/templates/env.j2' %}

HOST={{ ODOO_DB_HOST }}
USER={{ ODOO_DB_USER }}
PASSWORD={{ ODOO_DB_PASSWORD | dotenv_quote }}
ODOO_URL={{ ODOO_URL }}
ODOO_INIT_MODULES={{ ODOO_INIT_MODULES }}
ODOO_UPDATE_MARKER={{ ODOO_UPDATE_MARKER }}
{% if ODOO_OIDC_ENABLED | bool %}
ODOO_OIDC_CLIENT_ID={{ ODOO_OIDC_CLIENT_ID }}
ODOO_OIDC_CLIENT_SECRET={{ ODOO_OIDC_CLIENT_SECRET }}
ODOO_OIDC_ISSUER_URL={{ ODOO_OIDC_ISSUER_URL }}
ODOO_OIDC_TOKEN_URL={{ ODOO_OIDC_TOKEN_URL }}
ODOO_OIDC_JWKS_URI={{ ODOO_OIDC_JWKS_URI }}
ODOO_OIDC_UID_FIELD={{ ODOO_OIDC_UID_FIELD }}
ODOO_OIDC_GROUP_CLAIM={{ RBAC.GROUP.CLAIM }}
ODOO_OIDC_NAME_CLAIM={{ OIDC.ATTRIBUTES.NAME }}
ODOO_OIDC_EMAIL_CLAIM={{ OIDC.ATTRIBUTES.EMAIL }}
ODOO_OIDC_PHONE_CLAIM={{ OIDC.ATTRIBUTES.PHONE_NUMBER }}
ODOO_OIDC_LOCALE_CLAIM={{ OIDC.ATTRIBUTES.LOCALE }}
ODOO_OIDC_ZONEINFO_CLAIM={{ OIDC.ATTRIBUTES.ZONEINFO }}
{% endif %}
{% if ODOO_LDAP_ENABLED | bool %}
ODOO_LDAP_ATTR_FULLNAME={{ LDAP.USER.ATTRIBUTES.FULLNAME }}
ODOO_LDAP_ATTR_MAIL={{ LDAP.USER.ATTRIBUTES.MAIL }}
ODOO_LDAP_ATTR_PHONE={{ LDAP.USER.ATTRIBUTES.PHONE }}
ODOO_LDAP_ATTR_LOCALE={{ LDAP.USER.ATTRIBUTES.LOCALE }}
ODOO_LDAP_ATTR_TIMEZONE={{ LDAP.USER.ATTRIBUTES.TIMEZONE }}
ODOO_LDAP_ATTR_MEMBER_OF={{ ODOO_LDAP_ATTR_MEMBER_OF }}
{% endif %}
{% if (ODOO_OIDC_ENABLED | bool) or (ODOO_LDAP_ENABLED | bool) %}
{%- set odoo_rbac_roles = [] %}
{%- for odoo_rbac_role, odoo_rbac_groups in ODOO_RBAC_ROLE_GROUPS.items() %}
{%- set _ = odoo_rbac_roles.append({
      'path': '/' ~ lookup('rbac_group_path', application_id=application_id, role=odoo_rbac_role),
      'dn': 'cn=' ~ application_id ~ '-' ~ odoo_rbac_role ~ ',' ~ LDAP.DN.OU.ROLES,
      'groups': odoo_rbac_groups
    }) %}
{%- endfor %}
ODOO_RBAC_ROLES={{ odoo_rbac_roles | to_json | dotenv_quote }}
ODOO_RBAC_PROTECTED_LOGIN={{ ODOO_ADMINISTRATOR_USERNAME | dotenv_quote }}
{% endif %}
