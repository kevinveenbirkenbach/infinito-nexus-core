{% include 'roles/sys-svc-container/templates/env.j2' %}

HOME=/home/node
OPENCLAW_CONFIG_DIR={{ lookup('volume', application_id, 'openclaw_data').target }}
OPENCLAW_CONFIG_PATH={{ lookup('volume', application_id, 'openclaw_config').target }}
{% if OPENCLAW_TRUSTED_PROXY_ENABLED | bool %}
OPENCLAW_GATEWAY_PASSWORD={{ OPENCLAW_GATEWAY_SECRET | dotenv_quote }}
{% else %}
OPENCLAW_GATEWAY_TOKEN={{ OPENCLAW_GATEWAY_SECRET | dotenv_quote }}
{% endif %}
OPENCLAW_HOME=/home/node
OPENCLAW_STATE_DIR={{ lookup('volume', application_id, 'openclaw_data').target }}
OPENCLAW_WORKSPACE_DIR={{ [ lookup('volume', application_id, 'openclaw_data').target, 'workspace' ] | path_join }}
